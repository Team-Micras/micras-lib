# syntax=docker/dockerfile:1.27

# >>> host stage >>>
###############################################################################
# Host tools: shared byte for byte by micras-lib, micras-simulation and       #
# MicrasFirmware, whose CI compares the lines between the two markers         #
###############################################################################
FROM ubuntu:26.04 AS host

# The compilers and the clang tooling are pinned to a major version, so that a distribution update
# can move neither the generated code nor the formatting rules and the enabled check set
ARG HOST_GCC_VERSION=15
ARG HOST_CLANG_VERSION=22

# The apt caches are kept in BuildKit cache mounts instead of the image layers, so the hook that
# deletes the downloaded packages after every install has to go
RUN rm -f /etc/apt/apt.conf.d/docker-clean

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        cmake \
        doxygen \
        git \
        graphviz \
        ninja-build \
        python3 \
        python3-matplotlib \
        python3-numpy \
        "gcc-${HOST_GCC_VERSION}" \
        "g++-${HOST_GCC_VERSION}" \
        "clang-${HOST_CLANG_VERSION}" \
        "clang-format-${HOST_CLANG_VERSION}" \
        "clang-tidy-${HOST_CLANG_VERSION}"

WORKDIR /project
# <<< host stage <<<

#############################################################
# Reference projects' Cube files, generated by STM32CubeMX #
#############################################################
FROM thunderatz/stm32cubemx:6.18.1-h7 AS generator-h7

WORKDIR /project
COPY reference/h7/reference.ioc reference/h7/

# Without network, CubeMX skips its online update check, which can hang the project generation. The
# CMakeLists.txt and CMakePresets.json CubeMX writes next to the .ioc are its own suggestion of a
# project, which the reference replaces, so they are left out of the generated tree.
RUN --network=none <<EOT
    set -e
    printf 'config load /project/reference/h7/reference.ioc\nproject generate\nexit\n' > /tmp/cube_script
    xvfb-run --auto-servernum "${CUBE_PATH}/STM32CubeMX" -q /tmp/cube_script
    rm /tmp/cube_script
    test -f reference/h7/cmake/stm32cubemx/CMakeLists.txt || { echo "STM32CubeMX failed to generate the project" >&2; exit 1; }
    rm -f reference/h7/CMakeLists.txt reference/h7/CMakePresets.json reference/h7/reference.ioc
EOT

# Only the generated files, can be replaced by already generated ones with --build-context generated-h7=<dir>
FROM scratch AS generated-h7

COPY --from=generator-h7 /project/reference/h7 /

##########################################################
# ARM toolchain for the reference projects and benches   #
##########################################################
FROM host AS stm32

# The ARM libraries come prebuilt for every ARM core, only the Cortex-M4F and Cortex-M7 double
# precision ones are kept
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc-arm-none-eabi \
        libnewlib-arm-none-eabi \
        libstdc++-arm-none-eabi-newlib \
        make && \
    find /usr/lib/arm-none-eabi/lib/thumb /usr/lib/gcc/arm-none-eabi/*/thumb -mindepth 1 -maxdepth 1 \
        -not -name "v7e-m+fp" -not -name "v7e-m+dp" -exec rm -rf {} + && \
    rm -rf /usr/lib/arm-none-eabi/lib/arm /usr/lib/gcc/arm-none-eabi/*/arm
